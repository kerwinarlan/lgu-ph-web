{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["updated_at", "services"],
  "properties": {
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "service_name",
          "office",
          "classification",
          "processing_time",
          "fees",
          "required_documents"
        ],
        "properties": {
          "id": { "type": "string" },
          "service_name": { "type": "string" },
          "office": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["Simple", "Complex", "Highly Technical"]
          },
          "processing_time": { "type": "string" },
          "fees": { "type": "string" },
          "required_documents": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
