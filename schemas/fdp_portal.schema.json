{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["fiscal_year", "quarter", "documents"],
  "properties": {
    "fiscal_year": { "type": "integer" },
    "quarter": {
      "type": "string",
      "enum": ["Q1", "Q2", "Q3", "Q4", "Annual"]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "publication_date",
          "file_url",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "publication_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "file_url": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["Published", "Archived", "Pending"]
          }
        }
      }
    }
  }
}
